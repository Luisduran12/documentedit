# Copia este archivo como .env.local y rellena los valores. NUNCA subas .env.local a Git.

# Neon → tu proyecto → Connection string (empieza por postgresql://...)
DATABASE_URL=

# Cloudflare R2 → R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Generado con: npm run hash-password  (empieza por b64:)
ADMIN_PASSWORD_HASH=

# Cadena aleatoria de al menos 32 caracteres (ej.: openssl rand -hex 32)
SESSION_SECRET=

# Cadena aleatoria para proteger /api/cron/purge (ej.: openssl rand -hex 32)
CRON_SECRET=

# URL pública de la app, sin barra final (se usa en enlaces y QR)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: tu nombre, para las iniciales del avatar (ej.: "Luis Guerrero")
NEXT_PUBLIC_OWNER_NAME=
